{
  "name": "sync-o",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev:server": "pnpm --filter @synco/server dev",
    "dev:web": "pnpm --filter @synco/web dev",
    "dev:all": "pnpm --parallel --stream --filter @synco/server --filter @synco/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
